[Unit]
Description=AlertaSP - alertas de CPU, memória e disco
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
DynamicUser=true
ConfigurationDirectory=alertasp-monitor
ExecStart=/usr/local/lib/alertasp/monitor.sh --loop
Environment=MONITOR_CONFIG=/etc/alertasp-monitor/monitor.conf
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alertasp-monitor

[Install]
WantedBy=multi-user.target
