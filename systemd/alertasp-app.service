[Unit]
Description=AlertaSP - aplicação web de outra disciplina
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=alertasp
Group=alertasp
WorkingDirectory=/opt/alertasp/app
EnvironmentFile=/etc/alertasp/app.env
EnvironmentFile=/etc/alertasp/app-runtime.env
ExecStart=/opt/alertasp/app/bin/start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alertasp
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alertasp-app

[Install]
WantedBy=multi-user.target
